<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexaforge</groupId>
    <artifactId>backend-portfolio-projects</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Backend Portfolio Projects</name>
    <description>
        Production-quality backend engineering portfolio demonstrating distributed systems,
        microservices, event-driven architecture, and cloud-native patterns.
        
        Projects showcase Java 21, Spring Boot 3.x, Kafka, PostgreSQL, Redis,
        Elasticsearch, Docker, Kubernetes, and observability stack.
    </description>

    <developers>
        <developer>
            <name>Sharique Faizi</name>
            <url>https://github.com/shariquefaizi94-beep</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/shariquefaizi94-beep/backend-portfolio-projects</url>
        <connection>scm:git:git://github.com/shariquefaizi94-beep/backend-portfolio-projects.git</connection>
        <developerConnection>scm:git:ssh://github.com/shariquefaizi94-beep/backend-portfolio-projects.git</developerConnection>
    </scm>

    <modules>
        <!-- Project 1: Distributed Workflow Orchestration -->
        <module>workflow-orchestration-platform</module>
        
        <!-- Project 2: Event-Driven Order Platform -->
        <module>event-driven-order-platform</module>
        
        <!-- Project 3: Real-Time Streaming Analytics -->
        <module>realtime-streaming-analytics</module>
        
        <!-- Project 4: Production API Platform -->
        <module>production-api-platform</module>
        
        <!-- Project 5: Cloud-Native Microservices -->
        <module>cloud-native-microservices</module>
        
        <!-- Project 6: Observability & Reliability Platform -->
        <module>observability-reliability-platform</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                    <configuration>
                        <argLine>
                            --add-opens java.base/java.lang=ALL-UNNAMED
                            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens java.base/java.util=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
